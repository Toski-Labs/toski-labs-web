{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ],
    "redirects": [
      { "source": "/wallpapers", "destination": "/estudio/wallpapers", "type": 301 },
      { "source": "/en/wallpapers", "destination": "/en/studio/wallpapers", "type": 301 },
      { "source": "/pethealthtracker", "destination": "https://pethealth.toski-labs.com.br", "type": 301 },
      { "source": "/en/pethealthtracker", "destination": "https://pethealth.toski-labs.com.br/en", "type": 301 }
    ]
  }
}

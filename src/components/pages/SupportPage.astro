---
/** Suporte (PT e EN): contato, código de suporte e perguntas frequentes. */
import { Card, Icon, IconBox, Kicker, SectionHeading, buttonClasses } from '@toski-labs/ds';
import { getLang, href, SUPPORT_EMAIL } from '../../i18n/ui';
import FaqItem from '../ui/FaqItem.astro';

const lang = getLang(Astro.currentLocale);
const t = {
  pt: {
    kicker: 'Suporte',
    title: 'Como podemos ajudar?',
    lead: 'As respostas mais comuns estão aqui embaixo. Se não achar o que precisa, fale com a gente.',
    contactLabel: 'Contato',
    mailTitle: 'Fale com a gente',
    mailBody: `Mande um e-mail para ${SUPPORT_EMAIL}. Respondemos em até 2 dias úteis.`,
    mailCta: 'Escrever e-mail',
    copyMail: 'Copiar e-mail',
    copiedMail: 'E-mail copiado',
    mailSubject: 'Suporte PetHealthTracker',
    mailPick: 'Escolher como escrever o e-mail',
    mailWeb: 'no navegador',
    mailApp: 'App de e-mail',
    mailAppHint: 'Mail ou o app do seu aparelho',
    codeTitle: 'Inclua o seu código de suporte',
    codeBody: 'Ele ajuda a encontrar a sua conta sem você precisar mandar dados pessoais. Para copiar no app:',
    codeSteps: ['Ajustes', 'Ajuda e feedback', 'Sua conta', 'Copiar código'],
    codeStepsLabel: 'Caminho no app',
    faqTitle: 'Perguntas frequentes',
    faqLead: 'Sobre assinatura, conta e lembretes do PetHealthTracker.',
    faq: [
      ['Como restauro minha compra?', 'Em Ajustes, toque no card do seu plano e em Restaurar compras, usando o mesmo ID Apple da assinatura. O Plus acompanha o seu ID Apple, então funciona em qualquer iPhone com ele.'],
      ['Como cancelo a assinatura?', 'Em Ajustes, toque em Gerenciar assinatura no card do plano, ou vá em Ajustes do iPhone › seu nome › Assinaturas. Você continua no Plus até o fim do período já pago.'],
      ['Como peço reembolso?', 'Quem decide os reembolsos é a Apple. No app, vá em Ajustes › Ajuda e feedback › Pedir reembolso, que abre o pedido direto na Apple.'],
      ['O que acontece com meus pets se eu sair do Plus?', 'Você escolhe um pet para continuar ativo. Os outros ficam congelados: dá para ver tudo, mas eles saem da tela inicial e do calendário e param de lembrar. Nada é apagado, e todos voltam quando você assinar de novo.'],
      ['O app funciona sem internet?', 'Sim. Tudo fica salvo no iPhone e sincroniza com a sua conta quando a conexão voltar.'],
      ['Os lembretes não estão chegando.', 'Confira se as notificações do PetHealthTracker estão ligadas em Ajustes do iPhone › Notificações. Se estiverem desligadas, o app também avisa em Ajustes › Notificações.'],
      ['Como excluo minha conta?', 'Em Ajustes › Conta › Excluir conta. Isso apaga os seus dados e os dos seus pets. A assinatura é cancelada à parte, na Apple.'],
    ],
    privLine: 'Quer saber o que fazemos com os seus dados?',
    privCta: 'Ler a Política de Privacidade',
  },
  en: {
    kicker: 'Support',
    title: 'How can we help?',
    lead: 'The most common answers are below. If you can’t find what you need, get in touch.',
    contactLabel: 'Contact',
    mailTitle: 'Get in touch',
    mailBody: `Email ${SUPPORT_EMAIL}. We reply within 2 business days.`,
    mailCta: 'Send an email',
    copyMail: 'Copy email',
    copiedMail: 'Email copied',
    mailSubject: 'PetHealthTracker support',
    mailPick: 'Choose how to write the email',
    mailWeb: 'in your browser',
    mailApp: 'Email app',
    mailAppHint: 'Mail or your device’s app',
    codeTitle: 'Include your support code',
    codeBody: 'It helps us find your account without you sending any personal details. To copy it in the app:',
    codeSteps: ['Settings', 'Help & feedback', 'Your account', 'Copy code'],
    codeStepsLabel: 'Path in the app',
    faqTitle: 'FAQ',
    faqLead: 'About PetHealthTracker subscriptions, accounts and reminders.',
    faq: [
      ['How do I restore my purchase?', 'In Settings, tap your plan card and then Restore purchases, using the same Apple ID as your subscription. Plus follows your Apple ID, so it works on any iPhone signed in with it.'],
      ['How do I cancel my subscription?', 'In Settings, tap Manage subscription on the plan card, or go to iPhone Settings › your name › Subscriptions. You keep Plus until the end of the period you paid for.'],
      ['How do I ask for a refund?', 'Apple decides on refunds. In the app, go to Settings › Help & feedback › Request a refund, which opens the request with Apple.'],
      ['What happens to my pets if I leave Plus?', 'You choose one pet to keep active. The others are frozen: you can still see everything, but they leave the home screen and calendar and stop reminding you. Nothing is deleted, and they all come back when you subscribe again.'],
      ['Does the app work offline?', 'Yes. Everything is saved on your iPhone and syncs to your account when you’re back online.'],
      ['My reminders aren’t showing up.', 'Check that notifications for PetHealthTracker are on in iPhone Settings › Notifications. If they’re off, the app also lets you know in Settings › Notifications.'],
      ['How do I delete my account?', 'Go to Settings › Account › Delete account. This erases your data and your pets’ data. Your subscription is cancelled separately, with Apple.'],
    ],
    privLine: 'Want to know what we do with your data?',
    privCta: 'Read the Privacy Policy',
  },
}[lang];
const mailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(t.mailSubject)}`;
// O botão abre um menu: Gmail e Outlook no navegador (para quem não tem app de e-mail configurado, o mailto não abre nada) ou o app do aparelho.
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${SUPPORT_EMAIL}&su=${encodeURIComponent(t.mailSubject)}`;
const outlook = `https://outlook.live.com/mail/0/deeplink/compose?to=${SUPPORT_EMAIL}&subject=${encodeURIComponent(t.mailSubject)}`;
---

<section class="page pt-10 pb-10">
  <SectionHeading as="h1" kicker={t.kicker} title={t.title} lead={t.lead} />
</section>

<section aria-label={t.contactLabel} class="page flex flex-wrap gap-6 pb-22">
  <Card radius="panel" className="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 p-8">
    <IconBox name="mail" />
    <h2 class="mt-1 text-2xl font-semibold">{t.mailTitle}</h2>
    <p class="text-base leading-normal text-muted">{t.mailBody}</p>
    <div class="mt-1.5 flex flex-wrap gap-2.5">
      <details class="toski-mail group relative max-sm:flex-auto">
        <summary class={buttonClasses('primary', 'md', 'w-full cursor-pointer list-none [&::-webkit-details-marker]:hidden')} aria-label={t.mailPick}>
          {t.mailCta}<Icon name="chevron-down" size={18} stroke={2.2} className="transition-transform group-open:rotate-180" />
        </summary>
        <ul class="toski-menu absolute top-full left-0 z-20 mt-2 flex w-max min-w-full flex-col gap-0.5 rounded-card border border-line bg-surface p-1.5 shadow-[0_18px_44px_rgba(35,27,23,0.18)] [--menu-origin:top_left]">
          {[
            { label: 'Gmail', hint: t.mailWeb, href: gmail, external: true },
            { label: 'Outlook', hint: t.mailWeb, href: outlook, external: true },
            { label: t.mailApp, hint: t.mailAppHint, href: mailto, external: false },
          ].map((o) => (
            <li>
              <a
                href={o.href}
                target={o.external ? '_blank' : undefined}
                rel={o.external ? 'noopener' : undefined}
                class="flex min-h-11 flex-col justify-center rounded-[10px] px-3 py-1.5 leading-tight text-ink no-underline hover:bg-tint hover:text-ink"
              >
                <span class="text-[15px] font-semibold">{o.label}</span>
                <span class="text-xs text-muted">{o.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <!-- Para quem não tem um app de e-mail configurado (aí o mailto não abre nada). -->
      <button type="button" class={buttonClasses('secondary', 'md', 'toski-copy max-sm:flex-auto')} data-copy={SUPPORT_EMAIL} data-copied={t.copiedMail}><svg class="toski-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg><span data-text>{t.copyMail}</span></button>
    </div>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </Card>
  <Card variant="hero" radius="panel" className="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 p-8">
    <IconBox name="copy" on="surface" />
    <h2 class="mt-1 text-2xl font-semibold">{t.codeTitle}</h2>
    <p class="text-base leading-normal text-muted">{t.codeBody}</p>
    <ol aria-label={t.codeStepsLabel} class="mt-1.5 flex flex-wrap items-center gap-2">
      {t.codeSteps.map((step) => (
        <li class="inline-flex h-8.5 items-center rounded-[10px] bg-surface px-3 text-sm font-medium">{step}</li>
      ))}
    </ol>
  </Card>
</section>

<section aria-labelledby="faq-titulo" class="band bg-tint">
  <div class="page flex flex-wrap gap-x-16 gap-y-8 pt-20 pb-24">
    <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-2.5">
      <Kicker>PetHealthTracker</Kicker>
      <h2 id="faq-titulo" class="text-[clamp(30px,3.6vw,42px)] leading-[1.1] font-semibold tracking-[-0.02em]">{t.faqTitle}</h2>
      <p class="text-base leading-normal text-muted">{t.faqLead}</p>
    </div>
    <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-2.5">
      {t.faq.map(([q, a]) => <FaqItem question={q}><p>{a}</p></FaqItem>)}
    </div>
  </div>
</section>

<section class="page flex flex-wrap items-center justify-between gap-4 pt-14 pb-20">
  <p class="text-[17px] text-muted">{t.privLine}</p>
  <a href={href(lang, 'privacy')} class="inline-flex min-h-11 items-center text-base font-semibold no-underline hover:underline">{t.privCta}</a>
</section>

<script>
  // Menu do e-mail: fecha ao escolher, ao clicar fora ou com Esc, com uma saída curta (toski-menu do DS).
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.toski-mail')) {
    const list = menu.querySelector<HTMLElement>('.toski-menu');
    const close = () => {
      if (!menu.open || !list || list.hasAttribute('data-closing')) return;
      if (reduceMotion()) {
        menu.open = false;
        return;
      }
      list.dataset.closing = '';
      window.setTimeout(() => {
        menu.open = false;
        delete list.dataset.closing;
      }, 100);
    };
    menu.querySelector('summary')?.addEventListener('click', (e) => {
      if (!menu.open) return;
      e.preventDefault();
      close();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

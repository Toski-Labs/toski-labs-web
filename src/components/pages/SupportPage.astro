---
/** Suporte (PT e EN): contato, código de suporte e perguntas frequentes. */
import { Card, Icon, IconBox, SectionHeading, buttonClasses } from '@toski-labs/ds';
import { getLang, href, SUPPORT_EMAIL } from '../../i18n/ui';
import { projects } from '../../data/projects';
import ProductIcon from '../projects/ProductIcon.astro';

const lang = getLang(Astro.currentLocale);
const t = {
  pt: {
    kicker: 'Suporte',
    title: 'Como podemos ajudar?',
    lead: 'Cada app tem o próprio suporte, com as perguntas mais comuns. Para falar com a Toski Labs, escreva para a gente.',
    contactLabel: 'Contato',
    mailTitle: 'Fale com a gente',
    mailBody: `Mande um e-mail para ${SUPPORT_EMAIL}. Respondemos em até 2 dias úteis.`,
    mailCta: 'Escrever e-mail',
    copyMail: 'Copiar e-mail',
    copiedMail: 'E-mail copiado',
    mailSubject: 'Suporte Toski Labs',
    mailWeb: 'no navegador',
    mailApp: 'App de e-mail',
    mailAppHint: 'Mail ou o app do seu aparelho',
    appsKicker: 'Projetos',
    appsTitle: 'Suporte de cada app',
    appsLead: 'Assinatura, conta, lembretes e outras dúvidas ficam no site de cada app.',
    appSupport: 'Suporte do',
    privLine: 'Quer saber o que fazemos com os seus dados?',
    privCta: 'Ler a Política de Privacidade',
  },
  en: {
    kicker: 'Support',
    title: 'How can we help?',
    lead: 'Each app has its own support, with the most common answers. To reach Toski Labs, send us a message.',
    contactLabel: 'Contact',
    mailTitle: 'Get in touch',
    mailBody: `Email ${SUPPORT_EMAIL}. We reply within 2 business days.`,
    mailCta: 'Send an email',
    copyMail: 'Copy email',
    copiedMail: 'Email copied',
    mailSubject: 'Toski Labs support',
    mailWeb: 'in your browser',
    mailApp: 'Email app',
    mailAppHint: 'Mail or your device’s app',
    appsKicker: 'Projects',
    appsTitle: 'Support for each app',
    appsLead: 'Subscriptions, accounts, reminders and other questions live on each app’s site.',
    appSupport: 'Support for',
    privLine: 'Want to know what we do with your data?',
    privCta: 'Read the Privacy Policy',
  },
}[lang];
const mailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(t.mailSubject)}`;
// O botão abre um menu: Gmail e Outlook no navegador (para quem não tem app de e-mail configurado, o mailto não abre nada) ou o app do aparelho.
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${SUPPORT_EMAIL}&su=${encodeURIComponent(t.mailSubject)}`;
const outlook = `https://outlook.live.com/mail/0/deeplink/compose?to=${SUPPORT_EMAIL}&subject=${encodeURIComponent(t.mailSubject)}`;
---

<section class="page pt-10 pb-10">
  <SectionHeading as="h1" kicker={t.kicker} title={t.title} lead={t.lead} />
</section>

<section aria-label={t.contactLabel} class="page flex flex-wrap gap-6 pb-22">
  <Card radius="panel" className="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 p-8">
    <IconBox name="mail" />
    <h2 class="mt-1 text-2xl font-semibold">{t.mailTitle}</h2>
    <p class="text-base leading-normal text-muted">{t.mailBody}</p>
    <div class="mt-1.5 flex flex-wrap gap-2.5">
      <details class="toski-mail group relative max-sm:flex-auto">
        <summary class={buttonClasses('primary', 'md', 'w-full cursor-pointer list-none [&::-webkit-details-marker]:hidden')}>
          {t.mailCta}<Icon name="chevron-down" size={18} stroke={2.2} className="transition-transform group-open:rotate-180" />
        </summary>
        <ul role="list" class="toski-menu absolute top-full left-0 z-20 mt-2 flex w-max min-w-full flex-col gap-0.5 rounded-card border border-line bg-surface p-1.5 shadow-[0_18px_44px_rgba(35,27,23,0.18)] [--menu-origin:top_left]">
          {[
            { label: 'Gmail', hint: t.mailWeb, href: gmail, external: true },
            { label: 'Outlook', hint: t.mailWeb, href: outlook, external: true },
            { label: t.mailApp, hint: t.mailAppHint, href: mailto, external: false },
          ].map((o) => (
            <li>
              <a
                href={o.href}
                target={o.external ? '_blank' : undefined}
                rel={o.external ? 'noopener' : undefined}
                class="flex min-h-11 flex-col justify-center rounded-[10px] px-3 py-1.5 leading-tight text-ink no-underline hover:bg-tint hover:text-ink"
              >
                <span class="text-[15px] font-semibold">{o.label}</span>
                <span class="text-xs text-muted">{o.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <!-- Para quem não tem um app de e-mail configurado (aí o mailto não abre nada). -->
      <button type="button" class={buttonClasses('secondary', 'md', 'toski-copy max-sm:flex-auto')} data-copy={SUPPORT_EMAIL} data-copied={t.copiedMail}><svg class="toski-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg><span data-text>{t.copyMail}</span></button>
    </div>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </Card>
  <Card variant="hero" radius="panel" className="flex min-w-0 flex-[1_1_340px] flex-col gap-3.5 p-8">
    <IconBox name="copy" on="surface" />
    <h2 class="mt-1 text-2xl font-semibold">{t.appsTitle}</h2>
    <p class="text-base leading-normal text-muted">{t.appsLead}</p>
    <ul role="list" class="mt-1.5 flex flex-col gap-2.5">
      {projects.map((p) => (
        <li data-product={p.id} class="rounded-card">
          <a href={p.urls[lang].support} class="flex min-h-14 items-center gap-3 rounded-card bg-surface px-3.5 py-2 text-ink no-underline hover:text-ink">
            <ProductIcon product={p.id} size={36} class="size-9 rounded-[10px]" />
            <span class="grow text-base font-semibold">{t.appSupport} {p.name}</span>
            <Icon name="external-link" size={18} stroke={2} className="text-accent-text" />
          </a>
        </li>
      ))}
    </ul>
  </Card>
</section>

<section class="page flex flex-wrap items-center justify-between gap-4 pt-14 pb-20">
  <p class="text-[17px] text-muted">{t.privLine}</p>
  <a href={href(lang, 'privacy')} class="inline-flex min-h-11 items-center text-base font-semibold no-underline hover:underline">{t.privCta}</a>
</section>

<script>
  // Menu do e-mail: fecha ao escolher, ao clicar fora ou com Esc, com uma saída curta (toski-menu do DS).
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.toski-mail')) {
    const list = menu.querySelector<HTMLElement>('.toski-menu');
    const close = () => {
      if (!menu.open || !list || list.hasAttribute('data-closing')) return;
      if (reduceMotion()) {
        menu.open = false;
        return;
      }
      list.dataset.closing = '';
      window.setTimeout(() => {
        menu.open = false;
        delete list.dataset.closing;
      }, 100);
    };
    menu.querySelector('summary')?.addEventListener('click', (e) => {
      if (!menu.open) return;
      e.preventDefault();
      close();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

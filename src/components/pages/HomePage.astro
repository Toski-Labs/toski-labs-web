---
/** Home (PT e EN). O idioma vem da rota; os textos ficam aqui. */
import { Button, Icon, Kicker, Mascot, SectionHeading } from '@toski-labs/ds';
import { Image } from 'astro:assets';
import { getLang, href } from '../../i18n/ui';
import { projects } from '../../data/projects';
import MascotHero from '../brand/MascotHero.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import pacoca from '../../assets/fotos/pacoca-sorrindo.jpg';

const lang = getLang(Astro.currentLocale);
const t = {
  pt: {
    heroKicker: 'Laboratório de tecnologia · Recife',
    heroTitle: 'Soluções simples para problemas de verdade.',
    heroBody: 'A Toski Labs é um laboratório de tecnologia que transforma necessidades do dia a dia em apps para o ecossistema Apple: rápidos de testar e cuidadosos em cada detalhe.',
    seeProjects: 'Ver projetos',
    aboutLab: 'Sobre o laboratório',
    projKicker: 'Projetos',
    projTitle: 'O que está no laboratório',
    projLead: 'Cada projeto começa pequeno, ganha forma com quem usa e só chega à loja quando está pronto.',
    allProjects: 'Ver todos os projetos',
    aboutKicker: 'Sobre',
    aboutTitle: 'Essa é a Paçoca, CEO da Toski Labs.',
    about1: 'Toski é o apelido dessa golden retriever. Ela inspirou o nome, a logo, as cores e cada detalhe da nossa identidade, e é quem aprova (ou não) as ideias por aqui.',
    about2: 'A Toski Labs nasceu da vontade de cuidar melhor dela: vacina, remédio e banho, tudo no lugar certo. Desse cuidado veio o primeiro app e o jeito de trabalhar que levamos para todo projeto: testar rápido, ouvir quem usa e caprichar nos detalhes, com o mesmo carinho que a Paçoca recebe todo dia.',
    madeBy: 'Feito em Recife por Stefany, com supervisão da Paçoca ·',
    photoAlt: 'Paçoca, a CEO da Toski Labs, sorrindo',
  },
  en: {
    heroKicker: 'Tech lab · Recife, Brazil',
    heroTitle: 'Simple solutions for real problems.',
    heroBody: 'Toski Labs is a technology lab that turns everyday needs into apps for the Apple ecosystem: quick to try, and crafted with care in every detail.',
    seeProjects: 'See projects',
    aboutLab: 'About the lab',
    projKicker: 'Projects',
    projTitle: 'What’s in the lab',
    projLead: 'Every project starts small, takes shape with the people who use it, and only ships when it’s ready.',
    allProjects: 'See all projects',
    aboutKicker: 'About',
    aboutTitle: 'Meet Paçoca, CEO of Toski Labs.',
    about1: 'Toski is this golden retriever’s nickname. She inspired the name, the logo, the colors and every detail of our identity, and she’s the one who approves (or doesn’t) the ideas around here.',
    about2: 'Toski Labs was born from wanting to take better care of her: vaccines, medicines and baths, all in the right place. That care became the first app and the way we approach every project: test fast, listen to the people who use it and sweat the details, with the same love Paçoca gets every day.',
    madeBy: 'Made in Recife by Stefany, supervised by Paçoca ·',
    photoAlt: 'Paçoca, CEO of Toski Labs, smiling',
  },
}[lang];
---

<!-- Topo: no celular e no tablet em pé, tudo centralizado num eixo só (Paçoca, título, texto e botões); do md em diante, lado a lado. -->
<section class="page grid items-center gap-5 pt-2 pb-14 text-center md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] md:gap-14 md:pt-12 md:pb-24 md:text-left">
  <div class="order-2 flex min-w-0 flex-col items-center gap-4 md:order-1 md:items-start md:gap-6">
    <Kicker>{t.heroKicker}</Kicker>
    <h1 class="text-[clamp(34px,9.2vw,44px)] leading-[1.05] font-semibold tracking-tight text-balance md:text-[clamp(48px,5.4vw,66px)]">{t.heroTitle}</h1>
    <p class="max-w-130 text-[17px] leading-normal text-pretty text-muted md:text-[19px]">{t.heroBody}</p>
    <div class="mt-3 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-center md:justify-start">
      <Button href={href(lang, 'projects')} icon="arrow-right" className="justify-center max-sm:h-12 max-sm:text-base">{t.seeProjects}</Button>
      <Button href="#sobre" variant="secondary" className="justify-center max-sm:h-12 max-sm:text-base">{t.aboutLab}</Button>
    </div>
  </div>
  <div class="order-1 flex min-w-0 justify-center">
    <MascotHero class="max-w-34 sm:max-w-44 md:max-w-110" />
  </div>
</section>

<!-- Projetos -->
<section id="projetos" aria-labelledby="projetos-titulo" class="page flex scroll-mt-6 flex-col gap-8 pb-24">
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <SectionHeading id="projetos-titulo" kicker={t.projKicker} title={t.projTitle} lead={t.projLead} />
    <a href={href(lang, 'projects')} class="inline-flex min-h-11 items-center gap-2 text-base font-semibold text-link no-underline hover:underline">{t.allProjects}<Icon name="arrow-right" size={18} stroke={2.2} /></a>
  </div>
  <div class="flex flex-wrap items-stretch gap-6">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<!-- Por que Toski? -->
<section id="sobre" aria-labelledby="sobre-titulo" class="band scroll-mt-6 bg-tint">
  <div class="page flex flex-wrap items-center gap-x-16 gap-y-12 py-22">
    <figure class="relative mx-auto w-full max-w-75 flex-[0_1_300px]">
      <Image
        src={pacoca}
        alt={t.photoAlt}
        widths={[300, 600, 900]}
        sizes="300px"
        class="aspect-4/5 w-full rounded-panel bg-hero object-cover object-[50%_30%]"
      />
      <span class="absolute -right-3.5 -bottom-3.5 flex size-19 items-center justify-center rounded-full bg-tint" aria-hidden="true">
        <span class="flex size-16 items-center justify-center rounded-full bg-hero">
          <Mascot width={44} ball="none" />
        </span>
      </span>
    </figure>
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4">
      <Kicker>{t.aboutKicker}</Kicker>
      <h2 id="sobre-titulo" class="text-[clamp(30px,3.6vw,42px)] leading-[1.1] font-semibold tracking-[-0.02em]">{t.aboutTitle}</h2>
      <p class="max-w-150 text-lg leading-[1.55]">{t.about1}</p>
      <p class="max-w-150 text-lg leading-[1.55] text-muted">{t.about2}</p>
      <p class="mt-2 text-base text-muted">{t.madeBy} <a href="https://stefany-sa.com.br" class="font-medium">stefany-sa.com.br</a></p>
    </div>
  </div>
</section>

---
/**
 * Paçoca (mascote). Cores pelo tema: no escuro o corpo ganha contorno creme.
 * ball: 'bounce' = bolinha pulando (1,8 s; parada com "reduzir movimento") · 'still' = parada
 *       'ground' = caída no chão, menor e apagada (tela de erro / 404) · 'none' = sem bolinha
 * Camadas e medidas: ../../design/animacoes.md
 */
interface Props {
  width?: number | string;
  ball?: 'bounce' | 'still' | 'ground' | 'none';
  class?: string;
}
const { width = '100%', ball = 'bounce', class: className } = Astro.props;
const viewBox = ball === 'ground' ? '-40 -6 250 212' : '-6 -6 222 212';
---

<svg width={width} viewBox={viewBox} aria-hidden="true" class={className}>
  {(ball === 'bounce' || ball === 'still') && (
    <g class:list={[ball === 'bounce' && 'toski-ball']}>
      <circle cx="34" cy="168" r="16" fill="#DB9A5B" stroke-width="5" style="stroke: var(--toski-ball-outline)"></circle>
      <path d="M24 156 Q36 168 24 180 M44 156 Q32 168 44 180" fill="none" stroke-width="2.5" stroke-linecap="round" style="stroke: var(--toski-ball-outline)"></path>
    </g>
  )}
  {ball === 'ground' && (
    <g opacity="0.55">
      <circle cx="-18" cy="190" r="13" fill="#DB9A5B" stroke-width="4" style="stroke: var(--toski-background)"></circle>
      <path d="M-26 180 Q-16 190 -26 200 M-10 180 Q-20 190 -10 200" fill="none" stroke-width="2" stroke-linecap="round" style="stroke: var(--toski-background)"></path>
    </g>
  )}
  <path
    d="M26 90 C26 84 32 80 40 79 L74 72 C82 70 86 62 94 56 C104 48 124 46 140 52 C158 58 166 76 168 96 C172 120 182 150 196 200 L72 200 C66 190 74 184 68 176 C62 168 72 162 68 154 C64 146 74 140 74 132 C70 126 64 122 58 118 C48 114 38 110 32 104 C27 100 25 95 26 90 Z"
    fill="#A9541F"
    stroke-width="5"
    stroke-linejoin="round"
    style="stroke: var(--toski-mascot-outline)"
  ></path>
  <path d="M112 64 C128 56 148 62 150 78 C154 98 150 116 140 126 C136 132 128 132 124 126 C120 120 122 114 118 110 C112 96 104 78 112 64 Z" fill="#A9541F" stroke="#F4E4CC" stroke-width="4" stroke-linejoin="round"></path>
  <ellipse cx="96" cy="74" rx="4.4" ry="3" fill="#F4E4CC"></ellipse>
  <ellipse cx="31" cy="88" rx="7" ry="6" style="fill: var(--toski-mascot-nose)"></ellipse>
</svg>

---
/** Carteirinha de vacinação em PDF (exemplo da Paçoca) + botão de compartilhar ilustrativo. Papel sempre claro. */
import { getLang } from '../../i18n/ui';
import Icon from '../ui/Icon.astro';

const lang = getLang(Astro.currentLocale);
const copy = {
  pt: {
    aria: 'Exemplo de carteirinha de vacinação em PDF da Paçoca',
    doc: 'Carteirinha de vacinação',
    share: 'Compartilhar PDF',
    rows: [['V10', '12/03/2026'], ['Antirrábica', '12/03/2026'], ['Gripe canina', '20/04/2026'], ['Giárdia', '20/04/2026']],
  },
  en: {
    aria: 'Sample vaccine card PDF for Paçoca',
    doc: 'Vaccine card',
    share: 'Share PDF',
    rows: [['DHPP', 'Mar 12, 2026'], ['Rabies', 'Mar 12, 2026'], ['Canine flu', 'Apr 20, 2026'], ['Giardia', 'Apr 20, 2026']],
  },
}[lang];
---

<div class="flex w-full flex-col items-center gap-4">
  <div role="img" aria-label={copy.aria} class="flex w-full max-w-85 flex-col gap-4 rounded-button bg-white p-6 text-carvao shadow-[0_18px_44px_rgba(35,27,23,0.16)]">
    <div class="flex items-center justify-between gap-3 border-b border-[#E6D8C4] pb-3.5" aria-hidden="true">
      <div class="flex items-center gap-2.5">
        <span class="flex size-10 items-center justify-center rounded-full bg-caramelo text-[17px] font-semibold">P</span>
        <span class="flex flex-col gap-px"><span class="text-base font-semibold">Paçoca</span><span class="text-xs text-[#6B5648]">Golden retriever</span></span>
      </div>
      <span class="flex h-6 items-center rounded-md bg-[#F8E0D4] px-2 text-[11px] font-bold tracking-[0.04em] text-[#A3341A]">PDF</span>
    </div>
    <p class="text-xs font-semibold uppercase tracking-[0.06em] text-[#6B5648]" aria-hidden="true">{copy.doc}</p>
    <div class="flex flex-col" aria-hidden="true">
      {copy.rows.map(([name, date]) => (
        <div class="flex justify-between gap-3 border-b border-[#F3E4CF] py-2.25 text-sm">
          <span class="font-medium">{name}</span><span class="text-[#6B5648]">{date}</span>
        </div>
      ))}
    </div>
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="h-1.5 flex-3 rounded-full bg-[#F3E4CF]"></span>
      <span class="h-1.5 flex-2 rounded-full bg-[#F3E4CF]"></span>
    </div>
  </div>
  <span class="inline-flex h-11 items-center gap-2.5 rounded-full bg-surface px-4.5 text-[15px] font-medium shadow-[0_6px_18px_rgba(35,27,23,0.08)]" aria-hidden="true">
    <Icon name="share" size={18} stroke={2} class="text-accent" />{copy.share}
  </span>
</div>

---
/**
 * Aviso de idioma do navegador. Só aparece na primeira visita e nunca redireciona sozinho
 * (o robô do Google navega em inglês; redirecionar esconderia as páginas em português).
 * - navegador em PT numa página EN, ou em EN numa página PT: oferece a outra versão;
 * - navegador em es/fr/de/it numa página PT: mensagem no idioma da pessoa oferecendo o inglês;
 * - outros idiomas numa página PT: mensagem em inglês.
 * Fechar, "continuar" ou trocar de idioma gravam no navegador e o aviso não volta.
 */
import { Icon } from '@toski-labs/ds';
import { alternatePath, getLang, langNotice, STORAGE, type PageKey } from '../i18n/ui';

interface Props {
  page: PageKey;
}
const { page } = Astro.props;
const lang = getLang(Astro.currentLocale);
const config = {
  pageLang: lang,
  otherUrl: alternatePath(page, lang),
  storage: STORAGE,
  messages: langNotice,
};
---

<div
  class="toski-lang-banner pointer-events-none fixed inset-x-4 bottom-6 z-50 flex justify-center"
  data-config={JSON.stringify(config)}
  hidden
>
  <div role="region" class="pointer-events-auto relative flex w-full max-w-140 items-start gap-4 rounded-card border border-line bg-surface py-5 pr-14 pl-5 shadow-[0_18px_44px_rgba(35,27,23,0.16)]">
    <span class="flex size-11 shrink-0 items-center justify-center rounded-icon bg-tint text-accent">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18ZM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9Z"></path></svg>
    </span>
    <div class="flex min-w-0 flex-col gap-1.5">
      <p data-field="title" class="text-[17px] leading-[1.3] font-semibold"></p>
      <p data-field="body" class="text-[15px] leading-normal text-muted"></p>
      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a data-field="go" href="#" class="inline-flex h-11 items-center rounded-icon bg-accent px-4.5 text-[15px] font-semibold text-on-accent no-underline hover:bg-accent-hover hover:text-on-accent"></a>
        <button data-field="stay" type="button" class="inline-flex h-11 items-center px-1 text-[15px] font-medium text-ink underline underline-offset-[3px]"></button>
      </div>
    </div>
    <button data-field="close" type="button" class="absolute top-2 right-2 flex size-11 items-center justify-center rounded-full text-muted hover:bg-tint hover:text-ink">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
</div>

<script>
  type Message = { lang: string; title: string; body: string; go: string; stay: string; close: string; region: string };
  type Config = {
    pageLang: 'pt' | 'en';
    otherUrl: string;
    storage: { lang: string; langNotice: string };
    messages: Record<'es' | 'fr' | 'de' | 'it' | 'en' | 'pt' | 'other', Message>;
  };

  const read = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return '1'; // sem acesso ao armazenamento: não mostra o aviso
    }
  };
  const store = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* segue sem salvar */
    }
  };

  /** Escolhe a mensagem pelo idioma do navegador; null = não mostrar nada. */
  function pickMessage(config: Config): Message | null {
    const browser = (navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase().slice(0, 2);
    if (!browser) return null;
    if (browser === config.pageLang) return null;
    if (config.pageLang === 'en') return browser === 'pt' ? config.messages.pt : null;
    if (browser === 'en') return config.messages.en;
    const known = ['es', 'fr', 'de', 'it'] as const;
    return (known as readonly string[]).includes(browser) ? config.messages[browser as (typeof known)[number]] : config.messages.other;
  }

  const banner = document.querySelector<HTMLElement>('.toski-lang-banner');
  if (banner) {
    const config: Config = JSON.parse(banner.dataset.config!);
    const alreadyHandled = read(config.storage.langNotice) || read(config.storage.lang);
    const message = alreadyHandled ? null : pickMessage(config);
    if (message) {
      const field = (name: string) => banner.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
      const region = banner.querySelector<HTMLElement>('[role=region]')!;
      region.lang = message.lang;
      region.setAttribute('aria-label', message.region);
      field('title').textContent = message.title;
      field('body').textContent = message.body;
      field('go').textContent = message.go;
      (field('go') as HTMLAnchorElement).href = config.otherUrl;
      field('stay').textContent = message.stay;
      field('close').setAttribute('aria-label', message.close);

      const dismiss = () => {
        store(config.storage.langNotice, '1');
        banner.hidden = true;
      };
      field('stay').addEventListener('click', dismiss);
      field('close').addEventListener('click', dismiss);
      field('go').addEventListener('click', () => {
        store(config.storage.langNotice, '1');
        store(config.storage.lang, config.pageLang === 'pt' ? 'en' : 'pt');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !banner.hidden) dismiss();
      });
      banner.hidden = false;
    }
  }
</script>

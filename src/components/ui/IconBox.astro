---
/** Caixa de ícone 48 pt, raio 12, fundo tint e ícone na cor de destaque. */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  name: IconName;
  size?: 'md' | 'lg';
  /** Fundo da caixa: tint (padrão) ou superfície (quando o card já é tint/hero). */
  on?: 'tint' | 'surface';
  /** Cor do ícone. */
  tone?: 'accent' | 'muted';
  class?: string;
}
const { name, size = 'md', on = 'tint', tone = 'accent', class: className } = Astro.props;
---

<span
  class:list={[
    'flex shrink-0 items-center justify-center',
    tone === 'accent' ? 'text-accent' : 'text-muted',
    size === 'lg' ? 'size-22 rounded-[20px]' : 'size-12 rounded-icon',
    on === 'tint' ? 'bg-tint' : 'bg-surface',
    className,
  ]}
>
  <Icon name={name} size={size === 'lg' ? 36 : 24} stroke={size === 'lg' ? 1.6 : 1.8} />
</span>

---
/** Rótulo de seção: 13 px, 600, caixa alta, espaçado (sectionLabel do app). */
interface Props {
  tone?: 'accent' | 'muted';
  class?: string;
}
const { tone = 'accent', class: className } = Astro.props;
---

<p class:list={['text-[13px] font-semibold uppercase tracking-[0.06em]', tone === 'accent' ? 'text-accent-text' : 'text-muted', className]}>
  <slot />
</p>

---
/** Lista com check. success = verde (grátis) · accent = destaque (Plus, PDF). */
import Icon from './Icon.astro';

interface Props {
  items: string[];
  tone?: 'success' | 'accent';
  /** Em duas colunas quando houver espaço. */
  columns?: boolean;
  class?: string;
}
const { items, tone = 'accent', columns = false, class: className } = Astro.props;
---

<ul
  class:list={[
    columns ? 'grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-6 gap-y-3.5' : 'flex flex-col gap-3.5',
    className,
  ]}
>
  {items.map((item) => (
    <li class="flex gap-3 text-base leading-[1.45]">
      <Icon name="check" size={20} stroke={2.4} class={tone === 'success' ? 'mt-px text-success' : 'mt-px text-accent'} />
      <span>{item}</span>
    </li>
  ))}
</ul>

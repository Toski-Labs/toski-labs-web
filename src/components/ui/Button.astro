---
/**
 * Botão-link. Medidas do app: grande 54 pt (raio 14), médio 48 pt.
 * primary = cor de destaque · secondary = superfície com borda · light = superfície sem borda.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'light';
  size?: 'lg' | 'md';
  icon?: IconName;
}
const { href, variant = 'primary', size = 'lg', icon, class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-accent text-on-accent font-semibold hover:bg-accent-hover hover:text-on-accent',
  secondary: 'bg-surface text-ink font-medium border-[1.5px] border-line hover:border-accent hover:text-ink',
  light: 'bg-surface text-ink font-medium hover:text-ink hover:bg-tint',
};
const sizes = {
  lg: 'h-13.5 px-6 text-[17px]',
  md: 'h-12 px-5 text-base',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2.5 rounded-button no-underline transition-colors',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
  {icon && <Icon name={icon} size={18} stroke={2.2} />}
</a>

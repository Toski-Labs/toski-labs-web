---
/** Card de recurso. No celular fica compacto (ícone ao lado do texto); do sm em diante, ícone em cima. */
import { Card, IconBox } from '@toski-labs/ds';
import type { IconName } from '@toski-labs/ds';

interface Props {
  icon: IconName;
  title: string;
  variant?: 'surface' | 'plain';
}
const { icon, title, variant = 'surface' } = Astro.props;
---

<Card variant={variant} className="flex gap-4 p-5 sm:flex-col sm:gap-3 sm:p-7">
  <IconBox name={icon} className="max-sm:size-10" />
  <div class="flex min-w-0 flex-col gap-1 sm:gap-3">
    <h3 class="text-lg font-semibold sm:mt-1 sm:text-xl">{title}</h3>
    <p class="text-[15px] leading-normal text-muted sm:text-base"><slot /></p>
  </div>
</Card>

---
/** Rótulo + título + texto de apoio, como no topo de cada seção do canvas. */
import Kicker from './Kicker.astro';

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  id?: string;
  /** h1 no topo da página, h2 nas seções. */
  as?: 'h1' | 'h2';
  class?: string;
}
const { kicker, title, lead, id, as: Tag = 'h2', class: className } = Astro.props;
const titleSize =
  Tag === 'h1'
    ? 'text-[clamp(36px,4.6vw,56px)] leading-[1.06] tracking-tight'
    : 'text-[clamp(30px,3.6vw,42px)] leading-[1.1] tracking-[-0.02em]';
---

<div class:list={['flex flex-col gap-2.5', className]}>
  {kicker && <Kicker>{kicker}</Kicker>}
  <Tag id={id} class:list={['max-w-170 font-semibold text-balance', titleSize]}>{title}</Tag>
  {lead && <p class="max-w-160 text-[17px] leading-normal text-muted">{lead}</p>}
</div>

---
/**
 * Ícone do app (do DS) no tema da página: claro ou escuro. O do Pawta troca pelo ícone da data especial quando houver
 * (global.css), em todo lugar onde aparece: card da Home, /projetos e /suporte.
 * O escuro do DS vem com fundo transparente (no iOS 18 o sistema põe o fundo); aqui o fundo escuro entra na camada dele.
 */
import { ProductIcon } from '@toski-labs/ds';
import type { ProductId } from '../../data/projects';
import { arquivoDe, datas as datasEspeciais, temas } from '../../data/datas';

interface Props {
  product: ProductId;
  /** Lado em px do arquivo (qualidade). O tamanho na tela vem das classes (size-*). */
  size: number;
  class?: string;
}
const { product, size, class: className } = Astro.props;
const icones = product === 'pawta' ? temas.filter((tema) => datasEspeciais[tema].iconePawta.claro) : [];
---

<span class:list={['relative block shrink-0 overflow-hidden [&_span]:block [&_span]:size-full [&_svg]:size-full', className]}>
  <span data-art="light"><ProductIcon product={product} variant="light" size={size} /></span>
  <span data-art="dark" class="bg-background"><ProductIcon product={product} variant="dark" size={size} /></span>
  {
    icones.map((tema) => {
      const { claro, escuro } = datasEspeciais[tema].iconePawta;
      return (
        <span
          class="toski-icone-data absolute inset-0"
          data-para={tema}
          aria-hidden="true"
          style={{ '--img-claro': arquivoDe(tema, claro), ...(escuro && { '--img-escuro': arquivoDe(tema, escuro) }) }}
        />
      );
    })
  }
</span>

---
/** Card de um projeto na Home: ícone, status, nome, frase, descrição, tags e botões. A cor do produto vale só aqui dentro. */
import { Card, Pill } from '@toski-labs/ds';
import { getLang } from '../../i18n/ui';
import type { Project } from '../../data/projects';
import ProductIcon from './ProductIcon.astro';
import ProjectActions from './ProjectActions.astro';
import CampaignSeal from '../campaign/CampaignSeal.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<Card as="article" radius="panel" data-product={project.id} aria-labelledby={`proj-${project.id}`} className="flex min-w-0 flex-[1_1_460px] flex-col gap-5.5 p-6 sm:p-8">
  <div class="flex items-center justify-between gap-4 sm:flex-wrap">
    <ProductIcon product={project.id} size={88} class="size-16 rounded-[20px] sm:size-22" />
    <div class="flex min-w-0 flex-1 flex-wrap justify-end gap-2 sm:flex-none">
      <Pill variant="status">{project.status[lang]}</Pill>
      <Pill variant="outline">{project.platform[lang]}</Pill>
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <h3 id={`proj-${project.id}`} class="text-[28px] leading-[1.1] font-semibold tracking-[-0.02em] sm:text-[32px]">{project.name}</h3>
    <p class="text-lg leading-[1.4] font-medium text-accent-text">{project.tagline[lang]}</p>
    <p class="max-w-155 text-base leading-normal text-muted sm:text-[17px]">{project.description[lang]}</p>
  </div>
  {project.id === 'pethealth' && <CampaignSeal />}
  <ul role="list" class="flex flex-wrap gap-2">
    {project.tags[lang].map((tag) => <li><Pill className="max-sm:h-7 max-sm:px-2.5 max-sm:text-[13px]">{tag}</Pill></li>)}
  </ul>
  <div class="mt-auto flex flex-col gap-3 pt-2">
    <ProjectActions project={project} />
    <p class="-mt-1.5 text-[13px] text-muted">{project.host}</p>
  </div>
</Card>

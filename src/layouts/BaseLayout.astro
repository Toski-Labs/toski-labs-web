---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangBanner from '../components/LangBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import CampaignFlags from '../components/campaign/CampaignFlags.astro';
import CampaignBar from '../components/campaign/CampaignBar.astro';
import { alternatePath, getLang, routes, STORAGE, SUPPORT_EMAIL, useTranslations, type PageKey } from '../i18n/ui';

interface Props {
  page: PageKey;
  /** Título da página. Na Home fica só "Toski Labs". */
  title?: string;
  description: string;
  /** Páginas que não devem aparecer no Google (ex.: 404). */
  noindex?: boolean;
}

const { page, title, description, noindex = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const fullTitle = title ? `${title} — ${t('site.name')}` : `${t('site.name')} — ${t('site.tagline').replace(/\.$/, '')}`;
const site = Astro.site ?? new URL('https://toski-labs.web.app');
const canonical = new URL(routes[lang][page], site);
const alternate = new URL(alternatePath(page, lang), site);
const ptUrl = lang === 'pt' ? canonical : alternate;
const enUrl = lang === 'en' ? canonical : alternate;
// Imagem de compartilhamento: uma por seção (Suporte e Privacidade usam a da Home).
const ogFiles: Partial<Record<PageKey, string>> = { pethealthtracker: 'pethealthtracker', studio: 'studio', wallpapers: 'wallpapers', themes: 'themes' };
const ogImage = new URL(`/og/${ogFiles[page] ?? 'og'}-${lang}.png`, site);

// Dados estruturados (schema.org) para o Google entender o site. Não aparecem na tela.
const orgId = new URL('/#toski-labs', site).href;
const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: 'Toski Labs',
  url: new URL('/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
  email: SUPPORT_EMAIL,
  sameAs: ['https://github.com/Toski-Labs'],
  address: { '@type': 'PostalAddress', addressLocality: 'Recife', addressCountry: 'BR' },
};
const studioName = t('nav.studio');
const breadcrumb = (name: string) => ({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: studioName, item: new URL(routes[lang].studio, site).href },
    { '@type': 'ListItem', position: 2, name, item: canonical.href },
  ],
});
const graph: Record<string, unknown>[] = [organization];
if (page === 'home') graph.push({ '@type': 'WebSite', name: 'Toski Labs', url: new URL('/', site).href, inLanguage: ['pt-BR', 'en'], publisher: { '@id': orgId } });
if (page === 'pethealthtracker')
  graph.push({
    '@type': 'MobileApplication',
    name: 'PetHealthTracker',
    url: canonical.href,
    description,
    operatingSystem: 'iOS 18+',
    applicationCategory: 'LifestyleApplication',
    inLanguage: ['pt-BR', 'en'],
    publisher: { '@id': orgId },
  });
if (page === 'wallpapers') graph.push(breadcrumb('Wallpapers'));
if (page === 'themes') graph.push(breadcrumb(lang === 'pt' ? 'Temas' : 'Themes'));
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Tema salvo no menu de configurações, aplicado antes da pintura (sem piscar). -->
    <script is:inline define:vars={{ themeKey: STORAGE.theme }}>
      try {
        const theme = localStorage.getItem(themeKey);
        if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Google Search Console (verificação da propriedade https://toski-labs.web.app). Não remover. -->
    <meta name="google-site-verification" content="qjQAE1TWx_tZbA8Hlg-cpCpQ74gL0l8K9foXwFUM9TU" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={ptUrl} />
      </>
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F7F1E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#231B17" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Toski Labs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-button focus:bg-surface focus:px-4 focus:py-3">
      {t('skip')}
    </a>
    <CampaignBar />
    <Header page={page} />
    <main id="conteudo" class="grow">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <CampaignFlags />
    <LangBanner page={page} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
